{
  "name": "remote-settings-hub",
  "version": "0.1.0-alpha.2",
  "description": "Cloudflare Worker library that copies one GrowthBook project's payloads to R2, one encrypted rules file per app",
  "keywords": [
    "growthbook",
    "cloudflare-workers",
    "r2",
    "feature-flags",
    "remote-config"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangmirs/tauri-plugins.git",
    "directory": "packages/remote-settings-hub"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-timeout=10000 --experimental-strip-types src/*.test.ts"
  },
  "devDependencies": {
    "@growthbook/growthbook": "1.8.0",
    "@types/node": "26.6.1",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
