{
  "name": "tauri-plugin-remote-settings-api",
  "version": "0.1.0-alpha.1",
  "description": "Framework-neutral TypeScript facade for tauri-plugin-remote-settings: cached settings files, GrowthBook rules evaluated on the device, and Remote Config behind a switch",
  "keywords": [
    "tauri",
    "tauri-plugin",
    "growthbook",
    "feature-flags",
    "remote-config",
    "settings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangmirs/tauri-plugins.git",
    "directory": "packages/plugin-remote-settings"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./firebase": {
      "types": "./dist/firebase.d.ts",
      "import": "./dist/firebase.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-timeout=10000 --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "@growthbook/growthbook": "^1.8.0"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "tauri-plugin-firebase-api": ">=0.1.0-alpha.4"
  },
  "peerDependenciesMeta": {
    "tauri-plugin-firebase-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tauri-apps/api": "2.11.1",
    "@types/node": "26.6.1",
    "remote-settings-hub": "0.1.0-alpha.1",
    "tauri-plugin-firebase-api": "0.1.0-alpha.4",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
